---
import '../styles/main.scss';
import { buildSeo, type SeoInput } from '../lib/seo';
import { absoluteUrl, site } from '../lib/site';

interface Props {
  seo: SeoInput;
}
const seo = buildSeo(Astro.props.seo);
const feedUrl = absoluteUrl('/feed.xml');
---
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#161f30" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#eef2f8" media="(prefers-color-scheme: light)">

  <title>{seo.title}</title>
  <meta property="og:title" content={seo.headline}>
  <meta name="author" content={site.author}>
  <meta property="og:locale" content="en_US">
  <meta name="description" content={seo.description}>
  {seo.noIndex && <meta name="robots" content="noindex" />}
  <meta name="twitter:description" property="og:description" content={seo.description}>
  <link rel="canonical" href={seo.url}>
  <meta property="og:url" content={seo.url}>
  <meta property="og:site_name" content={site.title}>
  <meta property="og:type" content={seo.kind}>
  {seo.image && <meta property="og:image" content={seo.image} />}
  {seo.image && seo.imageAlt && <meta property="og:image:alt" content={seo.imageAlt} />}
  {seo.published && <meta property="article:published_time" content={seo.published} />}
  <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'}>
  <meta name="twitter:title" content={seo.headline}>
  {seo.image && <meta name="twitter:image" content={seo.image} />}
  {seo.image && seo.imageAlt && <meta name="twitter:image:alt" content={seo.imageAlt} />}
  <script type="application/ld+json" set:html={seo.jsonLd} />

  <link type="application/atom+xml" rel="alternate" href={feedUrl} title={site.title}>

  <link rel="preconnect" href="https://fonts.bunny.net">
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=noto-sans:400,400i,700,700i|atkinson-hyperlegible:400,400i,700,700i&display=swap">

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='s' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0%25' stop-color='%23d5d9df'/%3E%3Cstop offset='55%25' stop-color='%23a3a9b3'/%3E%3Cstop offset='100%25' stop-color='%23d5d9df'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='6' fill='%23161f30'/%3E%3Crect x='4' y='4' width='24' height='24' rx='4' fill='url(%23s)'/%3E%3Ctext x='50%25' y='58%25' text-anchor='middle' font-family='Georgia,serif' font-size='18' font-weight='700' fill='%23161f30'%3EK%3C/text%3E%3C/svg%3E">

  <script is:inline>document.documentElement.classList.remove('no-js');</script>
  <script is:inline>try { if (localStorage.getItem('kh-reader-mode') === 'on') document.documentElement.setAttribute('data-reader', 'on'); } catch (e) {}</script>
</head>
