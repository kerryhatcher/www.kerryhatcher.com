---
import { site } from '../lib/site';

interface Props {
  /** URL of the current page, used to mark the active nav item. */
  currentUrl?: string;
}
const { currentUrl } = Astro.props;
---
<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.title}, home`}>
      <span class="wordmark__mark" aria-hidden="true">K&middot;H</span>
      <span class="wordmark__name">{site.title}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.url} aria-current={currentUrl === item.url ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
