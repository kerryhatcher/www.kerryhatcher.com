---
import Base from '../layouts/Base.astro';
import { shortDate } from '../lib/dates';
import { getPosts, postUrl } from '../lib/posts';
import { site } from '../lib/site';
import { stripHtml, truncate } from '../lib/text';

const recent = (await getPosts()).slice(0, 5);
---
<Base
  seo={{
    title: `${site.title} | ${site.description}`,
    headline: site.title,
    description: site.description,
    path: '/404.html',
    kind: 'website',
    jsonLdType: 'WebPage',
  }}
>
  <article class="page error-404" data-reveal-stagger>
    <header class="page__header">
      <p class="kicker error-404__kicker" data-reveal>Error 404 &middot; Page not found</p>
      <h1 class="error-404__title" data-reveal>That link didn&rsquo;t go where it was supposed to.</h1>
      <p class="page__dek" data-reveal>Either the URL has a typo, or the piece moved when the site was reorganized. Both are common; neither requires the long apology. Two options for finding what you came for:</p>
    </header>

    <div class="error-404__body">
      <section class="error-404__section" data-reveal aria-labelledby="error-404-recent">
        <h2 class="error-404__section-title" id="error-404-recent">Recent writing</h2>
        <ul class="error-404__list">
          {recent.map((post) => (
            <li class="error-404__item">
              <a class="error-404__link" href={postUrl(post)}>
                <span class="error-404__post-title">{post.data.title}</span>
                <span class="error-404__post-meta">{shortDate(post.data.date)}</span>
                {post.data.dek && <span class="error-404__post-dek" set:html={truncate(stripHtml(post.data.dek), 140)} />}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <hr class="error-404__sep" aria-hidden="true" />

      <section class="error-404__section" data-reveal aria-labelledby="error-404-useful">
        <h2 class="error-404__section-title" id="error-404-useful">Always useful</h2>
        <ul class="error-404__list">
          <li class="error-404__item">
            <a class="error-404__link" href="/">
              <span class="error-404__kind">Home</span>
              <span class="error-404__post-title">The full archive of writing.</span>
            </a>
          </li>
          <li class="error-404__item">
            <a class="error-404__link" href="/about/">
              <span class="error-404__kind">About</span>
              <span class="error-404__post-title">Who Kerry is, and what this site is for.</span>
            </a>
          </li>
          <li class="error-404__item">
            <a class="error-404__link" href="/feed.xml">
              <span class="error-404__kind">Atom</span>
              <span class="error-404__post-title">The Atom feed for new posts.</span>
            </a>
          </li>
          <li class="error-404__item">
            <a class="error-404__link" href={`mailto:${site.email}`}>
              <span class="error-404__kind">Email</span>
              <span class="error-404__post-title">{site.email}</span>
            </a>
          </li>
        </ul>
      </section>

      <p class="error-404__sign" data-reveal>
        If this is broken from a link I shared, send the URL to <a href={`mailto:${site.email}`}>{site.email}</a> and I&rsquo;ll fix it.
      </p>
    </div>
  </article>
</Base>
