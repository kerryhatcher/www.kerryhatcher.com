---
// Legacy URL (an early typo'd slug that was shared) → current post.
// Kept as an explicit page so the canonical + noindex hints stay absolute.
import { absoluteUrl } from '../lib/site';

const target = '/out-of-runway-the-fy27-bcsd-budget/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Out of Runway: The FY27 BCSD Budget</title>
  <link rel="canonical" href={absoluteUrl(target)}>
  <meta http-equiv="refresh" content={`0; url=${target}`}>
  <meta name="robots" content="noindex">
  <style>
    body { font-family: system-ui, sans-serif; padding: 2rem; max-width: 40rem; margin: 0 auto; line-height: 1.6; }
  </style>
</head>
<body>
  <p>This post has moved. Redirecting you to
    <a href={target}>Out of Runway: The FY27 BCSD Budget</a>…
  </p>
  <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
</body>
</html>
